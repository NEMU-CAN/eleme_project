<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.iteleme.backend.mapper.BusinessAdminMapper">

    <select id="nextId" resultType="java.lang.Integer">
        select coalesce(max(`id`), 0) + 1 from `business_admin`
    </select>

    <select id="findByUserIdAndBusinessId" resultType="com.iteleme.backend.entity.BusinessAdmin">
        select * from `business_admin`
        where `user_id` = #{userId}
          and `business_id` = #{businessId}
        limit 1
    </select>

    <select id="listBusinessIdsByUserId" resultType="java.lang.Integer">
        select `business_id`
        from `business_admin`
        where `user_id` = #{userId}
        order by `business_id`
    </select>

    <insert id="insert" parameterType="com.iteleme.backend.entity.BusinessAdmin">
        insert into `business_admin` (`id`, `user_id`, `business_id`)
        values (#{id}, #{userId}, #{businessId})
    </insert>
</mapper>
